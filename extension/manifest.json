{
  "manifest_version": 3,
  "name": "NoteLume 剪藏",
  "version": "0.1.2",
  "description": "把网页正文剪藏到本机 NoteLume 知识库：按模板落盘，自动关联已有笔记",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "剪藏整页到 NoteLume",
    "default_icon": {
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "clip-shot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "截取选区图片剪藏到 NoteLume"
    },
    "clip-shot-box": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "框选区域截图剪藏到 NoteLume"
    }
  },
  "icons": {
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
