{
  "manifest_version": 3,
  "name": "NoteLume 剪藏",
  "version": "0.1.0",
  "description": "把网页正文剪藏到本机 NoteLume 知识库：按模板落盘，自动关联已有笔记",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "剪藏本页到 NoteLume",
    "default_icon": {
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
