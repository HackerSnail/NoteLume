{
  "name": "notelume",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NoteLume 根脚本：代理到 src/ 内本地安装的 @tauri-apps/cli（src-tauri 位于仓库根，tauri 命令需在根目录运行）",
  "scripts": {
    "dev": "node src/node_modules/@tauri-apps/cli/tauri.js dev",
    "build": "node src/node_modules/@tauri-apps/cli/tauri.js build",
    "build:web": "npm --prefix ./src run build",
    "web:build": "node server/gen-web-html.mjs && node src/node_modules/vite/bin/vite.js build --config src/web/vite.config.web.js",
    "web": "npm run web:build && node server/serve.mjs --open",
    "web:sandbox": "npm run web:build && node server/serve.mjs --sandbox --open",
    "web:api": "node server/serve.mjs --api-only --port 1430",
    "web:dev": "node src/node_modules/vite/bin/vite.js dev --config src/web/vite.config.web.js",
    "web:test": "node server/tests/run.mjs",
    "tauri": "node src/node_modules/@tauri-apps/cli/tauri.js",
    "test:roundtrip": "npm --prefix ./src run test:roundtrip",
    "test:footnote": "npm --prefix ./src run test:footnote",
    "test:merged-table": "npm --prefix ./src run test:merged-table"
  }
}
