{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认权限：核心 API + 文件夹选择对话框 + 关闭窗口前可销毁（未保存询问）+ 设置窗口标题 + 打印（mac 的 window.print 走 IPC）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:webview:allow-print",
    "core:window:allow-destroy",
    "core:window:allow-set-title"
  ]
}
