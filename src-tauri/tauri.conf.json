{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteLume",
  "version": "0.1.0",
  "identifier": "app.notelume.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ./src run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ./src run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteLume — Markdown 知识库编辑器",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.macOS.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
