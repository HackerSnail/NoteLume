# 依赖与构建产物
node_modules/
dist/
src-tauri/target/
src-tauri/gen/

# 临时/中间产物（脚手架文件一律放这里，禁止出现在工作区根）
tmp/
temp/
cache/
*.tmp
*.log
# 本地参考副本（Quarkdown 上游等），不入库：磁盘保留，git 只记上游地址
.others/
# 应用自存的库内备份副本（自动快照，不进版本库）
.notelume-backup/

# 编辑器/系统噪音
.DS_Store
Thumbs.db

# 无头调试产物（CDP 测试驱动与输出）
.cdp-profile/
src/__appdriver.mjs
src/app-err.txt
src/app-out.txt
src/app-result.txt

# 扩展签名产物（.pem 是私钥，.crx 是打包结果，都不入库）
extension.pem
extension.crx

# 站外草稿
docs/zhihu-notelume-draft.md
docs/zhihu-notelume-update.md